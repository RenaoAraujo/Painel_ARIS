# ============================================================================
# Guition JC1060 7" ESP32-P4 — sdkconfig.defaults
# ============================================================================

# --- Target ----------------------------------------------------------------
CONFIG_IDF_TARGET="esp32p4"

# --- Revisão do chip ESP32-P4 ---------------------------------------------
# O IDF 6.x assume por padrão rev. >= 3.1. Muitas placas no mercado usam rev. 1.x;
# sem isto o esptool recusa gravar: bootloader exige v3.1–v3.99 e o chip é v1.x.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# Rev. 1.x: PLL central 360 MHz — so 400 MHz CPU nao existe (ver rtc_clk_cpu_freq_mhz_to_config).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# --- Flash 16 MB -----------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- Tabela de partições customizada --------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- PSRAM HEX 32 MB @ 200 MHz (frame buffer LVGL precisa) ----------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# --- LVGL (esp_lvgl_port + lvgl 8.3.x) -------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_42=y

# --- FreeRTOS / task principal --------------------------------------------
CONFIG_FREERTOS_HZ=100
CONFIG_MAIN_TASK_STACK_SIZE=4096

# --- Console: USB Serial/JTAG como primário (stdin + stdout via USB CDC) --
# Necessário para que fgets(stdin) receba os CMD: enviados pelo backend.
# Com UART_DEFAULT, o stdout é espelhado no USB mas stdin fica só na UART0.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Logs -----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Task WDT (LVGL pode segurar a CPU em frames pesados durante bring-up) --
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
